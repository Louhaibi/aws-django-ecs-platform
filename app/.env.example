# Django values are intentionally unsafe and only suitable for local development.
DJANGO_SECRET_KEY=unsafe-local-development-key-do-not-use-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Keep these PostgreSQL values consistent with DATABASE_URL.
POSTGRES_DB=task_platform
POSTGRES_USER=task_platform
POSTGRES_PASSWORD=unsafe-local-development-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://task_platform:unsafe-local-development-password@127.0.0.1:5432/task_platform
