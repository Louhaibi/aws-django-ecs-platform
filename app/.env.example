# Django values are intentionally unsafe and only suitable for local development.
DJANGO_SECRET_KEY=unsafe-local-development-key-do-not-use-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
WEB_PORT=8000

# JWT values are intentionally unsafe and only suitable for local development.
JWT_SIGNING_KEY=unsafe-local-jwt-signing-key-change-me
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=1

# POSTGRES_PORT is the host port. Containers always connect to db:5432.
# Keep these PostgreSQL values consistent with the host DATABASE_URL.
# Use an unreserved, URL-safe local password because Compose derives the
# container DATABASE_URL from the same raw value.
POSTGRES_DB=task_platform
POSTGRES_USER=task_platform
POSTGRES_PASSWORD=unsafe-local-development-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://task_platform:unsafe-local-development-password@127.0.0.1:5432/task_platform
